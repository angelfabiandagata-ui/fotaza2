extends layout.pug

block content
  .container(style="max-width: 900px; margin: 20px auto; display: flex; gap: 20px; min-height: 500px; border: 1px solid #dbdbdb; border-radius: 8px; background: white;")
    
    //- Lista de contactos / conversaciones
    .sidebar(style="width: 35%; border-right: 1px solid #dbdbdb; padding: 15px;")
      h3(style="margin-top: 0;") Mensajes
      if contactos && contactos.length > 0
        ul(style="list-style: none; padding: 0;")
          each c in contactos
            li(style="margin-bottom: 10px;")
              a(
                href=`/mensajes?con=${c.id}` 
                style=`text-decoration: none; font-weight: ${contactoActivo && contactoActivo.id === c.id ? 'bold' : 'normal'}; color: #007bff; display: block; padding: 8px; border-radius: 4px; background: ${contactoActivo && contactoActivo.id === c.id ? '#e3f2fd' : 'transparent'};`
              ) 💬 #{c.username}
      else
        p(style="color: #888; font-size: 0.9rem;") No tienes conversaciones activas.

    //- Panel de chat activo
    .chat-area(style="width: 65%; display: flex; flex-direction: column; padding: 15px;")
      if contactoActivo
        h3(style="margin-top: 0; border-bottom: 1px solid #eee; padding-bottom: 10px;") Conversando con: #{contactoActivo.username}
        
        .messages-list(style="flex-grow: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; margin-bottom: 15px; max-height: 350px;")
          each m in mensajesChat
            - const esMio = m.user_id_emisor === userLogueado.id
            div(style=`align-self: ${esMio ? 'flex-end' : 'flex-start'}; background: ${esMio ? '#007bff' : '#f1f1f1'}; color: ${esMio ? 'white' : '#333'}; padding: 8px 12px; border-radius: 6px; max-width: 70%;`)
              p(style="margin: 0; font-size: 0.9rem;") #{m.content}
              small(style="font-size: 0.7rem; opacity: 0.7; display: block; text-align: right; margin-top: 4px;") #{new Date(m.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}

        form(action="/mensajes/enviar" method="POST" style="display: flex; gap: 10px;")
          input(type="hidden" name="receptorId" value=contactoActivo.id)
          input(type="text" name="content" placeholder="Escribe tu mensaje..." required style="flex-grow: 1; padding: 8px; border: 1px solid #ccc; border-radius: 4px;")
          button(type="submit" style="background: #007bff; color: white; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer; font-weight: bold;") Enviar
      else
        p(style="color: #888; text-align: center; margin-top: 100px;") Selecciona una conversación para ver los mensajes.