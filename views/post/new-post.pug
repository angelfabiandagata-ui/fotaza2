extends ../layout.pug

block content
  .post-container
    .post-card
      h2.post-global-title Nueva Publicación

      form#form-post(action='/post/new' method='POST' class="post-form")
        
        .post-left-column
          label.photo-upload-zone(for="file-post-input")
            .photo-preview-box(style="height: auto; min-height: 350px; display: flex; flex-direction: row; flex-wrap: wrap; gap: 10px; padding: 15px;")
              #preview-container(style="display: flex; flex-wrap: wrap; gap: 10px; width: 100%;")
              
              .upload-placeholder
                span.upload-icon 📸+
                p.upload-text Seleccionar una o más fotos
            
          input#file-post-input(type="file" accept="image/*" multiple required)
          input#post-base64-array(type="hidden" name="imagenesInput")

        .post-right-column
          .form-group
            label(for='titulo') Título
            input#titulo(type='text' name='titulo' placeholder="Título" required)

          .form-group
            label(for='descripcion') Pie de publicación (Descripción)
            textarea#descripcion(name='descripcion' rows="4" placeholder="Descripción" required)

          .form-group.license-section(style="margin-top: 15px;")
            label.checkbox-label(style="display: flex; align-items: center; gap: 8px; cursor: pointer;")
              input#checkbox-license(type="checkbox" name="hasLicense")
              span.checkbox-text ¿Esta publicación requiere Licencia / Copyright?

          #watermark-container.form-group.watermark-section.disabled-section(style="margin-top: 15px; opacity: 0.4; transition: opacity 0.3s;")
            label(for="input-watermark" style="display: block; margin-bottom: 5px;") Seleccionar imagen para la Marca de Agua:
            input#input-watermark(type="file" accept="image/*" disabled)
            

            input#watermark-base64(type="hidden" name="watermarkInput")
            p.form-help-text(style="font-size: 0.8rem; color: #888; margin: 4px 0 0 0;") Se aplicará sobre las fotos del posteo.


          .form-group.tags-section(style="margin-top: 15px;")
            label(for="input-tags" style="display: block; margin-bottom: 5px;") Etiquetas / Labels (Separadas por coma):
            input#input-tags(type="text" name="labels" placeholder="ej: naturaleza, autos, cordoba, verano" style="width: 100%; padding: 8px; box-sizing: border-box;")

          button(type='submit' class="btn-auth" style="margin-top: 25px; width: 100%;") Compartir Publicacion

  script.
      const form = document.querySelector('#form-post');
      const fileInput = document.querySelector('#file-post-input');
      const previewContainer = document.querySelector('#preview-container');
      const placeholder = document.querySelector('.upload-placeholder');
      const hiddenInput = document.querySelector('#post-base64-array');
      
      const checkboxLicense = document.querySelector('#checkbox-license');
      const watermarkContainer = document.querySelector('#watermark-container');
      const inputWatermark = document.querySelector('#input-watermark');
      const hiddenWatermark = document.querySelector('#watermark-base64');
      
      let base64Guardados = [];
      let watermarkBase64 = '';
      
      // Procesador de imagenes base64 para la vista previa
      fileInput.addEventListener('change', async (e) => {
          const files = Array.from(e.target.files);
          previewContainer.innerHTML = ''; 
          if (files.length > 0) {
              placeholder.style.display = 'none';
              const base64Promises = files.map(file => {
                  return new Promise((resolve) => {
                      const reader = new FileReader();
                      reader.onloadend = () => resolve(reader.result);
                      reader.readAsDataURL(file);
                  });
              });
              base64Guardados = await Promise.all(base64Promises);
              base64Guardados.forEach(base64 => {
                  const img = document.createElement('img');
                  img.src = base64;
                  img.style.width = 'calc(50% - 5px)'; 
                  img.style.height = '150px'; 
                  img.style.objectFit = 'cover'; 
                  img.style.borderRadius = '4px';
                  previewContainer.appendChild(img);
              });
          } else {
              placeholder.style.display = 'block';
              base64Guardados = [];
          }
      });
      
      // Convertidor asíncrono para la estampa de la marca de agua
      inputWatermark.addEventListener('change', (e) => {
          const file = e.target.files[0];
          if (file) {
              const reader = new FileReader();
              reader.onloadend = () => { watermarkBase64 = reader.result; };
              reader.readAsDataURL(file);
          } else {
              watermarkBase64 = '';
          }
      });
      
      // Interruptor dinámico de interfaz para la sección de copyright
      checkboxLicense.addEventListener('change', (e) => {
          if (e.target.checked) {
              watermarkContainer.style.opacity = '1'; 
              watermarkContainer.style.pointerEvents = 'auto'; 
              inputWatermark.removeAttribute('disabled');
          } else {
              watermarkContainer.style.opacity = '0.4'; 
              watermarkContainer.style.pointerEvents = 'none'; 
              inputWatermark.setAttribute('disabled', 'true'); 
              inputWatermark.value = ''; 
              watermarkBase64 = '';
          }
      });
      
     form.addEventListener('submit', async (e) => {
          e.preventDefault(); 

          if (base64Guardados.length === 0) {
              crearToast("Por favor, selecciona al menos una foto antes de publicar", "error"); 
              return;
          }

          // Armamos el paquete con TODOS los datos del formulario
          const datosEnviar = {
              imagenesInput: JSON.stringify(base64Guardados),
              watermarkInput: watermarkBase64,
              titulo: document.querySelector('#titulo').value,
              descripcion: document.querySelector('#descripcion').value,
              hasLicense: checkboxLicense.checked,
              labels: document.querySelector('#input-tags').value
          };

          try {
              // Enviamos los datos al servidor 
              const response = await fetch('/post/new', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify(datosEnviar)
              });

              const data = await response.json();

              if (data.success) {
                  // Si el controlador guardó todo bien, redirigimos por JS
                  window.location.href = '/explorar'; 
              } else {
                  // el middleware manda el JSON y se dibuja el Toast flotante
                  crearToast(data.message || "No se pudo subir la publicación", "error");
              }

          } catch (error) {
              console.error(" Error de red al publicar:", error);
              crearToast("Error de conexión al subir la publicación", "error");
          }
      });

      // FUNCIÓN DE TOAST FLOTANTE LOCAL
      function crearToast(mensaje, tipo = "success") {
          const toast = document.createElement("div");
          toast.classList.add("toast-flotante", tipo);
          toast.innerText = mensaje;

          document.body.appendChild(toast);

          setTimeout(() => {
              toast.classList.add("fade-out");
              toast.addEventListener("transitionend", () => toast.remove());
          }, 3000);
      }