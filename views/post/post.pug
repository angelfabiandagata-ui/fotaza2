extends ../layout.pug

block content
  .post-detail-container
    
    //- COLUMNA IZQUIERDA: Carrusel de Fotos
    .post-detail-media
      if imagenesDetalladas && imagenesDetalladas.length > 0
        .carousel-slides
          each img, index in imagenesDetalladas
            .slide-wrapper(data-index=index style="position: relative; display: ${index === 0 ? 'block' : 'none'};")
              img.carousel-img(
                src=img.url, 
                alt=publicacion.title, 
                data-index=index
              )

              if img.watermark
                img.carousel-watermark(
                  src=img.watermark
                  alt="Marca de agua"
                  style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: contain; pointer-events: none; opacity: 0.25;"
                )
        
        if imagenesDetalladas.length > 1
          button#prev-slide.carousel-btn ❮
          button#next-slide.carousel-btn ❯
      else
        img.carousel-img-placeholder(src="/images/default-placeholder.png")

    //- COLUMNA DERECHA: Datos dinamicos por IMAGEN
    .post-detail-info
      
      //- Cabecera fija de la Publicación Madre
      .post-info-header
        //- Contenedor flex para alinear el nombre del creador con el botón de seguir
        .creator-row(style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 15px;")
          span.creator-name(style="font-weight: bold; color: #555; font-size: 1rem;") 
           | Creador: #{publicacion.usuarioCreador ? publicacion.usuarioCreador.username : 'Usuario Desconocido'}
          
          //- Solo aparece si la publicación NO es del usuario logueado
          if !esSuPropioPost
            button#btn-follow(
              data-creator-id=publicacion.user_id 
              style=`padding: 6px 16px; border-radius: 20px; border: 1px solid #007bff; font-weight: bold; cursor: pointer; transition: all 0.2s; font-size: 0.85rem; background: ${yaLoSigue ? '#fff' : '#007bff'}; color: ${yaLoSigue ? '#007bff' : '#fff'};`
            ) #{yaLoSigue ? 'Siguiendo' : 'Seguir'}

        h3.post-info-title #{publicacion.title}
        p.post-info-desc #{publicacion.description}
        - const listaTags = etiquetas || publicacion.etiquetas
        if listaTags && listaTags.length > 0
            .post-info-tags(style="display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0 15px 0;")
              each tag in listaTags
                span.badge-tag(style="background-color: #e3f2fd; color: #0d6efd; padding: 4px 10px; border-radius: 15px; font-size: 0.8rem; font-weight: 500; text-transform: lowercase;") 
                  | ##{tag.name}


        span#photo-counter.photo-counter-text Imagen 1 de #{imagenesDetalladas.length}

      //- SECCIÓN DE VALORACIÓN DINÁMICA (Cambia por imagen)
      .post-info-rating
        .rating-display
          span.rating-label Valoración de esta foto: 
          span#current-rating ⭐ 0.0
          span#current-votes  (0 votos)
        
        form#form-rating.rating-form
          input#hidden-image-id-rating(type="hidden" name="imageId")
          span.rating-prompt Puntuar foto:
          select#select-rating.rating-select
            option(value="1") 1 ⭐
            option(value="2") 2 ⭐
            option(value="3") 3 ⭐
            option(value="4") 4 ⭐
            option(value="5") 5 ⭐
          button(type="submit").btn-rating-submit Votar

      //- LISTA DE COMENTARIOS DINÁMICA (Cambia por imagen)
      .post-info-comments#comments-box


      //- Caja de entrada para el comentario de la foto actual
      .post-info-footer
        form#form-comment.comment-form
          input#hidden-image-id-comment(type="hidden" name="imageId")
          input#input-comment-text(type="text", placeholder="Añade un comentario ", required).comment-input
          button(type="submit").btn-comment-submit Publicar

  script
    | window.listaImagenes = !{JSON.stringify(imagenesDetalladas)};

  //- llamado al script externo
  script(src="/js/show-post.js")