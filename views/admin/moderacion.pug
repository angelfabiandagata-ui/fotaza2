extends ../layout.pug

block content
  .container(style="max-width: 1000px; margin: 30px auto; padding: 20px;")
    h2(style="color: #333; margin-bottom: 5px;") 🛡️ Panel del Validador de Contenidos
    p(style="color: #666; margin-bottom: 25px; font-size: 0.95rem;")
      | Publicaciones en lista de trabajo con imágenes que han acumulado más de 3 denuncias de distintos usuarios

    if !publicaciones || publicaciones.length === 0
      div(style="text-align: center; padding: 40px; background: #fff; border-radius: 8px; border: 1px solid #e0e0e0;")
        p(style="font-size: 1.1rem; color: #28a745; margin: 0;") ✅ No hay publicaciones pendientes de revisión
    else
      each pub in publicaciones
        .card-moderacion(style="background: #fff; border: 1px solid #dee2e6; border-radius: 8px; padding: 20px; margin-bottom: 25px; box-shadow: 0 2px 5px rgba(0,0,0,0.05);")
          .card-header-mod(style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid #eee; padding-bottom: 10px; margin-bottom: 15px;")
            div
              h3(style="margin: 0 0 5px 0; color: #212529;") #{pub.title}
              span(style="font-size: 0.85rem; color: #6c757d;")
                | Creador: 
                strong(style="color: #333;") #{pub.usuarioCreador ? pub.usuarioCreador.username : 'Desconocido'} 
                | | Bajas acumuladas: #{pub.usuarioCreador ? pub.usuarioCreador.number_publications_removed : 0}/3
            div(style="display: flex; gap: 10px;")
              button.btn-dar-baja(
                data-post-id=pub.id
                style="padding: 8px 14px; background: #dc3545; color: white; border: none; border-radius: 4px; font-weight: bold; cursor: pointer; font-size: 0.85rem;"
              ) 🚫 Dar de baja publicación

          p(style="color: #555; margin-bottom: 15px; font-size: 0.9rem;") #{pub.description}

          //- Listado de fotos denunciadas en esta publicación
          .images-reported-list
            each img in pub.images
              if img.denuncias && img.denuncias.length > 3
                .image-mod-item(style="display: flex; gap: 20px; background: #f8f9fa; border: 1px solid #e9ecef; border-radius: 6px; padding: 15px; margin-bottom: 15px;")
                  div(style="width: 160px; flex-shrink: 0; text-align: center;")
                    img(src=img.url style="width: 100%; height: 120px; object-fit: cover; border-radius: 4px; border: 1px solid #ccc;")
                    span(style="display: block; font-size: 0.75rem; color: #888; margin-top: 4px;") ID Imagen: #{img.id}
                    button.btn-desestimar(
                      data-image-id=img.id
                      style="margin-top: 8px; padding: 4px 10px; background: #6c757d; color: white; border: none; border-radius: 4px; font-size: 0.75rem; cursor: pointer;"
                    ) Desestimar denuncias

                  div(style="flex-grow: 1;")
                    h4(style="margin: 0 0 10px 0; color: #dc3545; font-size: 0.95rem;") 🚩 #{img.denuncias.length} Denuncias registradas:
                    div(style="max-height: 120px; overflow-y: auto;")
                      each den in img.denuncias
                        .denuncia-item(style="font-size: 0.85rem; padding: 6px 0; border-bottom: 1px dashed #ddd;")
                          strong(style="color: #495057;") #{den.denunciante ? den.denunciante.username : 'Usuario'}: 
                          span(style="color: #b02a37; font-weight: 500;") [#{den.reason}] 
                          span(style="color: #666;") #{den.description}

  script.
    // Manejo de eventos 
    document.querySelectorAll('.btn-dar-baja').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const postId = e.target.getAttribute('data-post-id');
        if (!confirm("¿Confirmas la baja definitiva de esta publicación? Si el autor acumula 3 bajas su cuenta será suspendida.")) return;

        try {
          const res = await fetch('/admin/publicacion/baja', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ postId })
          });
          const data = await res.json();
          if (data.success) {
            alert(data.message);
            location.reload();
          } else {
            alert(data.message || 'Error al procesar la baja');
          }
        } catch (err) {
          console.error(err);
          alert('Error de conexión al dar de baja');
        }
      });
    });

    document.querySelectorAll('.btn-desestimar').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const imageId = e.target.getAttribute('data-image-id');
        if (!confirm("¿Deseas desestimar las denuncias de esta imagen? La publicación saldrá de la lista de trabajo")) return;

        try {
          const res = await fetch('/admin/denuncia/desestimar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ imageId })
          });
          const data = await res.json();
          if (data.success) {
            alert(data.message);
            location.reload();
          } else {
            alert(data.message || 'Error al desestimar');
          }
        } catch (err) {
          console.error(err);
          alert('Error de conexión al desestimar');
        }
      });
    });